  "additionalProperties": false,
  "properties": {
    "request_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "base_revision": {
      "minimum": 1,
      "title": "Base Revision",
      "type": "integer"
    },
    "operations": {
      "items": {
        "discriminator": {
          "mapping": {
            "insert_block": "#/$defs/InsertBlock",
            "insert_section": "#/$defs/InsertSection",
            "move_block": "#/$defs/MoveBlock",
            "move_section": "#/$defs/MoveSection",
            "remove_block": "#/$defs/RemoveBlock",
            "remove_section": "#/$defs/RemoveSection",
            "rename_report": "#/$defs/RenameReport",
            "rename_section": "#/$defs/RenameSection",
            "replace_block": "#/$defs/ReplaceBlock",
            "set_datasets": "#/$defs/SetReportDatasets",
            "set_presentation_settings": "#/$defs/SetPresentationSettings",
            "set_slide_settings": "#/$defs/SetSlideSettings"
          },
          "propertyName": "op"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/SetSlideSettings"
          },
          {
            "$ref": "#/$defs/SetPresentationSettings"
          },
          {
            "$ref": "#/$defs/RenameReport"
          },
          {
            "$ref": "#/$defs/SetReportDatasets"
          },
          {
            "$ref": "#/$defs/InsertSection"
          },
          {
            "$ref": "#/$defs/RenameSection"
          },
          {
            "$ref": "#/$defs/MoveSection"
          },
          {
            "$ref": "#/$defs/RemoveSection"
          },
          {
            "$ref": "#/$defs/InsertBlock"
          },
          {
            "$ref": "#/$defs/ReplaceBlock"
          },
          {
            "$ref": "#/$defs/MoveBlock"
          },
          {
            "$ref": "#/$defs/RemoveBlock"
          }
        ]
      },
      "maxItems": 30,
      "minItems": 1,
      "title": "Operations",
      "type": "array"
    },
    "summary": {
      "default": "Edited report structure",
      "maxLength": 200,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "base_revision",
    "operations"
  ],
  "title": "ReportOperationsRequest",
  "type": "object"
}
