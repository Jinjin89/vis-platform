        "before_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Before Id"
        },
        "after_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "After Id"
        },
        "op": {
          "const": "insert_block",
          "title": "Op",
          "type": "string"
        },
        "section_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Section Id",
          "type": "string"
        },
        "block": {
          "discriminator": {
            "mapping": {
              "figure": "#/$defs/ReportFigureBlock",
              "table": "#/$defs/ReportTableBlock",
              "text": "#/$defs/ReportTextBlock"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/ReportTextBlock"
            },
            {
              "$ref": "#/$defs/ReportFigureBlock"
            },
            {
              "$ref": "#/$defs/ReportTableBlock"
            }
          ],
          "title": "Block"
        }
      },
      "required": [
        "op",
        "section_id",
        "block"
      ],
      "title": "InsertBlock",
      "type": "object"
    },
