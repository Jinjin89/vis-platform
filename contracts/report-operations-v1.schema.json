    "SlideSettings": {
      "additionalProperties": false,
      "properties": {
        "layout": {
          "default": "figure-summary",
          "enum": [
            "title",
            "figure-summary",
            "two-column",
            "statement",
            "table"
          ],
          "title": "Layout",
          "type": "string"
        },
        "notes": {
          "default": "",
          "maxLength": 12000,
          "title": "Notes",
          "type": "string"
        },
        "frames": {
          "additionalProperties": {
            "$ref": "#/$defs/SlideFrame"
          },
          "maxProperties": 200,
          "title": "Frames",
          "type": "object"
        }
      },
      "title": "SlideSettings",
      "type": "object"
    }
