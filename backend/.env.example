# DeepSeek API configuration
DEEPSEEK_API_KEY=
VIS_PLATFORM_LLM_PROVIDER=deepseek
VIS_PLATFORM_LLM_BASE_URL=https://api.deepseek.com
VIS_PLATFORM_LLM_MODEL=deepseek-v4-flash-vision-exp
VIS_PLATFORM_LLM_THINKING_ENABLED=true
VIS_PLATFORM_LLM_REASONING_EFFORT=high
VIS_PLATFORM_LLM_TIMEOUT_SECONDS=120
VIS_PLATFORM_DEVELOPER_TRACE_ENABLED=false
VIS_PLATFORM_DEVELOPER_TRACE_TOKEN=

# Local backend storage
VIS_PLATFORM_DATABASE_PATH=var/vis-platform.sqlite3
VIS_PLATFORM_ARTIFACT_ROOT=var/artifacts

# Analysis-platform adapter (see docs/ANALYSIS_PLATFORM_CONTRACT.md)
VIS_PLATFORM_ANALYSIS_PLATFORM_URL=
VIS_PLATFORM_ANALYSIS_PLATFORM_TOKEN=

# Optional override of the auto-detected backend/.runtime installation
VIS_PLATFORM_R_HOME=
VIS_PLATFORM_R_SANDBOX=
