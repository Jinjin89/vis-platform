{
  "$defs": {
    "FigureDataset": {
      "additionalProperties": false,
      "properties": {
        "dataset_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Dataset Id",
          "type": "string"
        }
      },
      "required": [
        "dataset_id"
      ],
      "title": "FigureDataset",
      "type": "object"
    },
    "FigureLegend": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "default": "",
          "maxLength": 1000,
          "title": "Title",
          "type": "string"
        },
        "entries": {
          "additionalProperties": {
            "maxLength": 4000,
            "type": "string"
          },
          "description": "Legend text keyed by panel ID.",
          "maxProperties": 40,
          "propertyNames": {
            "maxLength": 160,
            "minLength": 1
          },
          "title": "Entries",
          "type": "object"
        }
      },
      "title": "FigureLegend",
      "type": "object"
    },
    "FigurePage": {
      "additionalProperties": false,
      "properties": {
        "width_mm": {
          "maximum": 500,
          "minimum": 20,
          "title": "Width Mm",
          "type": "number"
        },
        "height_mm": {
          "description": "The fixed page height, or the maximum height when height_mode is auto.",
          "maximum": 1000,
          "minimum": 20,
          "title": "Height Mm",
          "type": "number"
        },
        "height_mode": {
          "default": "auto",
          "description": "Auto ends the page one margin below the lowest panel.",
          "enum": [
            "fixed",
            "auto"
          ],
          "title": "Height Mode",
          "type": "string"
        },
        "margin_mm": {
          "default": 5,
          "maximum": 50,
          "minimum": 0,
          "title": "Margin Mm",
          "type": "number"
        }
      },
      "required": [
        "width_mm",
        "height_mm"
      ],
      "title": "FigurePage",
      "type": "object"
    },
    "FigurePanel": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "content": {
          "discriminator": {
            "mapping": {
              "image": "#/$defs/ImagePanelContent",
              "plot": "#/$defs/PlotPanelContent",
              "slot": "#/$defs/SlotPanelContent"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/PlotPanelContent"
            },
            {
              "$ref": "#/$defs/ImagePanelContent"
            },
            {
              "$ref": "#/$defs/SlotPanelContent"
            }
          ],
          "title": "Content"
        },
        "x_mm": {
          "maximum": 1000,
          "minimum": 0,
          "title": "X Mm",
          "type": "number"
        },
        "y_mm": {
          "maximum": 1000,
          "minimum": 0,
          "title": "Y Mm",
          "type": "number"
        },
        "scale": {
          "default": 1,
          "description": "Displayed size relative to the content's natural size; 1 keeps it unscaled.",
          "maximum": 10,
          "minimum": 0.05,
          "title": "Scale",
          "type": "number"
        },
        "label": {
          "anyOf": [
            {
              "maxLength": 8,
              "minLength": 1,
              "pattern": "^\\S(.*\\S)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A custom label. Null assigns the next letter in reading order.",
          "title": "Label"
        },
        "show_label": {
          "default": true,
          "title": "Show Label",
          "type": "boolean"
        },
        "locked": {
          "default": false,
          "description": "Automatic arrangement keeps this panel fixed.",
          "title": "Locked",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "content",
        "x_mm",
        "y_mm"
      ],
      "title": "FigurePanel",
      "type": "object"
    },
    "ImagePanelContent": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "image",
          "default": "image",
          "title": "Type",
          "type": "string"
        },
        "image_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Image Id",
          "type": "string"
        }
      },
      "required": [
        "image_id"
      ],
      "title": "ImagePanelContent",
      "type": "object"
    },
    "PanelLabelStyle": {
      "additionalProperties": false,
      "properties": {
        "case": {
          "default": "upper",
          "enum": [
            "upper",
            "lower"
          ],
          "title": "Case",
          "type": "string"
        },
        "size_pt": {
          "default": 10,
          "maximum": 24,
          "minimum": 5,
          "title": "Size Pt",
          "type": "number"
        },
        "bold": {
          "default": true,
          "title": "Bold",
          "type": "boolean"
        },
        "font_family": {
          "default": "Arial",
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9 \\-]*$",
          "title": "Font Family",
          "type": "string"
        }
      },
      "title": "PanelLabelStyle",
      "type": "object"
    },
    "PlotPanelContent": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "plot",
          "default": "plot",
          "title": "Type",
          "type": "string"
        },
        "version_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Version Id",
          "type": "string"
        },
        "source_version_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The version this panel's rendering was sized from. Update checks compare against it.",
          "title": "Source Version Id"
        },
        "ignored_version_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A newer version of this plot that the user chose not to apply.",
          "title": "Ignored Version Id"
        }
      },
      "required": [
        "version_id"
      ],
      "title": "PlotPanelContent",
      "type": "object"
    },
    "SlotPanelContent": {
      "additionalProperties": false,
      "description": "A planned panel: the size and description of a plot that does not exist yet.",
      "properties": {
        "type": {
          "const": "slot",
          "default": "slot",
          "title": "Type",
          "type": "string"
        },
        "prompt": {
          "default": "",
          "description": "What the plot should show; the request given to the plotting agent.",
          "maxLength": 8000,
          "title": "Prompt",
          "type": "string"
        },
        "width_mm": {
          "maximum": 500,
          "minimum": 5,
          "title": "Width Mm",
          "type": "number"
        },
        "height_mm": {
          "maximum": 1000,
          "minimum": 5,
          "title": "Height Mm",
          "type": "number"
        }
      },
      "required": [
        "width_mm",
        "height_mm"
      ],
      "title": "SlotPanelContent",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "title": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "page": {
      "$ref": "#/$defs/FigurePage"
    },
    "labels": {
      "$ref": "#/$defs/PanelLabelStyle"
    },
    "panels": {
      "description": "Drawing order: later panels are drawn on top.",
      "items": {
        "$ref": "#/$defs/FigurePanel"
      },
      "maxItems": 40,
      "title": "Panels",
      "type": "array"
    },
    "legend": {
      "$ref": "#/$defs/FigureLegend"
    },
    "datasets": {
      "description": "Plots created in this figure use these datasets; none means project data.",
      "items": {
        "$ref": "#/$defs/FigureDataset"
      },
      "maxItems": 50,
      "title": "Datasets",
      "type": "array"
    },
    "min_font_pt": {
      "default": 5,
      "description": "Text smaller than this on the printed page is reported by the checks.",
      "maximum": 12,
      "minimum": 4,
      "title": "Min Font Pt",
      "type": "number"
    }
  },
  "required": [
    "title",
    "page"
  ],
  "title": "FigureCompositionContent",
  "type": "object"
}
