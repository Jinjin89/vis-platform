      "required": [
        "id",
        "title"
      ],
      "title": "ReportSection",
      "type": "object"
    },
    "ReportTableBlock": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Id",
